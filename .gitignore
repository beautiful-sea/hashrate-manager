dist/
artifacts/
server/
.codex/
.env
.env.*
*.log
*.pem
*.key
state.json
reports.json
analytics.json
Cookies*
Cache/
Partitions/
__pycache__/
/scripts/inspect-*
/scripts/diagnose-*
/scripts/probe-*
/scripts/verify-creation-readers.cjs
/scripts/setup-updates-host.py
/scripts/publish-release.cjs
/docs/METRICAS.md
